# ── App ──────────────────────────────────────────────────────────────
APP_NAME="FitAI Coach"
APP_VERSION="0.1.0"
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────
# 兩種執行情境用不同的 host，不要搞混：
#
#   localhost  在本機直接跑 Python 時用（pytest、evals、scripts）
#   db         在 api 容器裡跑時用（Compose 的內部網路以 service 名稱當 hostname）
#
# 這裡填 localhost 就好——docker-compose.yml 會在容器內覆寫成 db。
DATABASE_URL=postgresql+psycopg://fitai:password@localhost:5432/fitai

# ── LLM-ANTHROPIC ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

# ── LLM-OPENAI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# ── Langfuse (observability) ──────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
