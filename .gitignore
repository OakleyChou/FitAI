*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual envs / Poetry
.venv/
venv/
env/

# Environment variables — NEVER commit real keys
.env
.env.local
.env.*.local

# pytest / coverage
